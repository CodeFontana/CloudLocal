@inherits DemoPage
@using System.Text
@using CodeFoxtrot.CloudLocal.Queues
@inject IQueueStore Store

<h2 class="h4 mt-4">Storage queue</h2>
<div class="row g-3">
    <div class="col-md-4"><label class="form-label" for="storage-queue">Queue</label><input id="storage-queue" class="form-control" @bind="_queue" /></div>
    <div class="col-md-8"><label class="form-label" for="storage-body">Body</label><input id="storage-body" class="form-control" @bind="_body" /></div>
</div>
<div class="d-flex flex-wrap gap-2 my-3">
    <button class="btn btn-outline-primary" disabled="@IsBusy" @onclick="CreateAsync">Create</button>
    <button class="btn btn-primary" disabled="@IsBusy" @onclick="SendAsync">Enqueue</button>
    <button class="btn btn-outline-primary" disabled="@IsBusy" @onclick="ReceiveAsync">Receive</button>
    <button class="btn btn-outline-danger" disabled="@IsBusy" @onclick="DeleteAsync">Delete received</button>
    <button class="btn btn-outline-secondary" disabled="@IsBusy" @onclick="PoisonAsync">List poison</button>
</div>
<ActionFeedback Message="@StatusMessage" Detail="@Detail" IsError="@IsError" />

@code {
    private string _queue = "jobs";
    private string _body = "hello";
    private string? _messageId;
    private string? _receipt;

    private Task CreateAsync() => RunAsync(async () =>
    {
        await Store.CreateQueueAsync(_queue);
        return $"Created storage queue '{_queue}'.";
    });

    private Task SendAsync() => RunAsync(async () =>
    {
        await Store.SendAsync(_queue, Encoding.UTF8.GetBytes(_body));
        return $"Enqueued '{_body}' on storage queue '{_queue}'.";
    });

    private Task ReceiveAsync() => RunAsync(async () =>
    {
        IReadOnlyList<QueueMessage> messages = await Store.ReceiveAsync(_queue, TimeSpan.FromSeconds(30), 1);
        if (messages.Count == 0)
        {
            return new ActionFeedbackResult($"Storage queue '{_queue}' has no visible message.");
        }

        QueueMessage message = messages[0];
        _messageId = message.MessageId;
        _receipt = message.Receipt;
        return new ActionFeedbackResult(
            $"Received message {message.MessageId} from storage queue '{_queue}'. Dequeue count is {message.DequeueCount}. It stays hidden for 30 seconds.",
            Encoding.UTF8.GetString(message.Body));
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        if (_messageId is null || _receipt is null)
        {
            throw new InvalidOperationException($"Receive a message on storage queue '{_queue}' before deleting it.");
        }

        string messageId = _messageId;
        await Store.DeleteAsync(_queue, messageId, _receipt);
        _messageId = null;
        _receipt = null;
        return $"Deleted message {messageId} from storage queue '{_queue}'.";
    });

    private Task PoisonAsync() => RunAsync(async () =>
    {
        IReadOnlyList<QueueMessage> messages = await Store.ListPoisonAsync(_queue);
        string? detail = messages.Count == 0
            ? null
            : string.Join(Environment.NewLine, messages.Select(message => $"{message.MessageId}: {Encoding.UTF8.GetString(message.Body)}"));
        return new ActionFeedbackResult($"Storage queue '{_queue}' has {messages.Count} poison message(s).", detail);
    });
}
