@page "/secrets"
@rendermode InteractiveServer
@inherits DemoPage
@using CodeFoxtrot.CloudLocal.Vault
@inject ISecretStore Store

<PageTitle>Secrets</PageTitle>
<h1>Secrets</h1>
<div class="row g-3">
    <div class="col-md-4"><label class="form-label" for="secret-name">Name</label><input id="secret-name" class="form-control" @bind="_name" /></div>
    <div class="col-md-8"><label class="form-label" for="secret-value">Value</label><input id="secret-value" class="form-control" @bind="_value" /></div>
</div>
<div class="d-flex flex-wrap gap-2 my-3">
    <button class="btn btn-primary" disabled="@IsBusy" @onclick="SetAsync">Set</button>
    <button class="btn btn-outline-primary" disabled="@IsBusy" @onclick="GetAsync">Get</button>
    <button class="btn btn-outline-primary" disabled="@IsBusy" @onclick="ListAsync">List</button>
    <button class="btn btn-outline-danger" disabled="@IsBusy" @onclick="DeleteAsync">Delete</button>
</div>
<ActionFeedback Message="@StatusMessage" Detail="@Detail" IsError="@IsError" />

@code {
    private string _name = "demo-secret";
    private string _value = "s3cret";

    private Task SetAsync() => RunAsync(async () =>
    {
        await Store.SetAsync(_name, _value);
        return $"Saved secret '{_name}'.";
    });

    private Task GetAsync() => RunAsync(async () =>
    {
        string value = await Store.GetAsync(_name);
        return new ActionFeedbackResult($"Read secret '{_name}'.", value);
    });

    private Task ListAsync() => RunAsync(async () =>
    {
        IReadOnlyList<string> names = await Store.ListAsync();
        string? detail = names.Count == 0 ? null : string.Join(Environment.NewLine, names);
        return new ActionFeedbackResult($"Listed {names.Count} secret(s).", detail);
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Store.DeleteAsync(_name);
        return $"Deleted secret '{_name}'.";
    });
}
